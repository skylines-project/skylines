# =============================================================================
# SkyLines Production Environment Variables
# =============================================================================
#
# Copy this file to .env and fill in your production values.
# NEVER commit .env to version control.
#
# See docs/DEPLOY.docker.md for full deployment instructions.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED - These must be set for production
# -----------------------------------------------------------------------------

# PostgreSQL credentials (must be strong, unique passwords)
POSTGRES_USER=skylines
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=skylines

# Flask secret key for session signing (generate with: openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_STRING

# -----------------------------------------------------------------------------
# TLS / HTTPS Configuration
# -----------------------------------------------------------------------------
# Default: external reverse proxy handles TLS and forwards HTTP to port 80.
# Leave DOMAIN=localhost and TLS_EMAIL empty for this mode.

# Domain for in-compose Caddy (use localhost when external proxy handles TLS)
DOMAIN=localhost

# Email for Let's Encrypt (optional: set both DOMAIN and TLS_EMAIL to enable
# automatic TLS via Caddy instead of external proxy)
TLS_EMAIL=

# -----------------------------------------------------------------------------
# OPTIONAL - Defaults are provided but can be customized
# -----------------------------------------------------------------------------

# Docker image to use (default: build from local Dockerfile)
# SKYLINES_IMAGE=ghcr.io/skylines-project/skylines:latest

# SMTP server for sending emails (password reset, notifications)
SMTP_SERVER=localhost
EMAIL_FROM=SkyLines <no-reply@skylines.aero>

# Worker configuration
GUNICORN_WORKERS=4
MAPPROXY_WORKERS=4

# Port configuration (rarely need to change)
HTTP_PORT=80
HTTPS_PORT=443
TRACKING_PORT=5597

# Map tile URL (internal service URL)
SKYLINES_MAP_TILE_URL=/mapproxy
